// SWARM RABBIT HOLE — Wave 10 / DIFF-4 (Impl-O): the chan-send seam
// of E0803.2 — sending a handle into a global pool over a channel
// while the pool is unfrozen at the send site. Same rule, same race:
// the receiving thread could race the freelist with the mutator.
// Frozen-outside-window and synchronized handles send freely.
//
// This file is a compile-FAIL golden case (tests/golden.rs).

pool<int> gq = pool_new<int>(8)

fn main() {
    chan<int> ch
    int h = 0
    unfrozen (gq) {
        h = gq.insert(9)
        ch.send(h)              // E0803.2 (chan flavor, handle 'h')
    }
}
