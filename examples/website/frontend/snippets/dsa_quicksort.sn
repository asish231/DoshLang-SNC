fn quicksort(list<int> xs) -> list<int> {
    if (xs.length() <= 1) {
        return xs
    }
    int pivot = xs[0]
    list<int> lo = []
    list<int> hi = []
    int i = 1
    while (i < xs.length()) {
        if (xs[i] <= pivot) {
            lo.push(xs[i])
        } else {
            hi.push(xs[i])
        }
        i = i + 1
    }
    list<int> out = quicksort(lo)
    out.push(pivot)
    list<int> rest = quicksort(hi)
    int j = 0
    while (j < rest.length()) {
        out.push(rest[j])
        j = j + 1
    }
    return out
}

fn main() {
    list<int> xs = [33, 4, 19, 8, 27, 4, 51]
    list<int> sorted = quicksort(xs)
    print("Sorted: " + cast(sorted.length(), str) + " items")
    int i = 0
    while (i < sorted.length()) {
        print(sorted[i])
        i = i + 1
    }
}
