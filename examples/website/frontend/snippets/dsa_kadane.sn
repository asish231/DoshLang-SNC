fn kadane(list<int> nums) -> int {
    int max_so_far = nums[0]
    int curr_max = nums[0]
    int i = 1
    int n = nums.length()
    while (i < n) {
        if (nums[i] > curr_max + nums[i]) {
            curr_max = nums[i]
        } else {
            curr_max = curr_max + nums[i]
        }
        if (curr_max > max_so_far) {
            max_so_far = curr_max
        }
        i = i + 1
    }
    return max_so_far
}

fn main() {
    list<int> arr = [-2, 1, -3, 4, -1, 2, 1, -5, 4]
    print("Max Subarray Sum: " + cast(kadane(arr), str))
}
