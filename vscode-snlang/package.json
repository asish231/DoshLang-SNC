{
  "name": "snlang",
  "displayName": "SNlang",
  "description": "SNlang language support for VS Code",
  "version": "1.0.1",
  "publisher": "snlang",
  "icon": "logo.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/asish231/SNCLang.git"
  },
  "engines": {
    "vscode": "^1.50.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "snlang",
        "aliases": [
          "SNlang",
          "sn"
        ],
        "extensions": [
          ".sn"
        ],
        "icon": {
          "light": "logo.png",
          "dark": "logo.png"
        },
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "snlang",
        "scopeName": "source.snlang",
        "path": "./syntaxes/snlang.json"
      }
    ]
  }
}
