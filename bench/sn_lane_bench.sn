// SNlang Elastic-Lane benchmark — SWARM RABBIT HOLE, Impl-C (Cohort Delta, Wave 5).
// D0 §7 skeleton, rows reshaped per the wave-5 bench brief.
//
// Shapes measured (rows; the C/Rust/Go twins implement the identical set):
//   timer      — cost of one time_now_ms() call pair (SNlang's only clock is
//                ms-resolution; every phase here is >= 10x that, and ns/op is
//                computed as elapsed_ms * 1e6 / ops by integer arithmetic).
//   resetpair  — one lane_save + lane_restore call pair on an idle lane: the
//                region-construct overhead (ir.rs lowers region{} to exactly
//                these two calls on lane 0).
//   emptyloop  — N iterations of i = i + 1: the language's loop tax, paid by
//                every other row.
//   amort16    — ONE region { } around the whole N-loop: save/restore
//                amortized to zero; 16-byte records; checksum via ptr_int;
//                scratch pointer store per op; read pass INSIDE the region
//                (live memory), touching word 0 of every record.
//   amort16x   — the same shape with explicit lane_save/lane_restore so the
//                wholesale reset is timed on its own (it reads 0 ms at this
//                clock; the bound comes from resetpair).
//   fresh16    — region { } per iteration: enter/exit cost inside the loop.
//   fresh4k    — region { } per iteration at 4096 B: memset-sensitivity row.
//   freshlcg   — region { } per iteration, sizes 16..63 from a fixed LCG
//                (state = (state*1103515245+12345) mod 2^31, seed 12345) so the
//                comparison is not flattered by branch-predictable uniform
//                sizes. lcg_state_final must match the twins exactly.
//
// Zeroing control (memset asymmetry, DIFF-6): the SAME binary run with
// SN_POISON=1 fills every allocation with 0xAA AND re-poisons the freed range
// on every rewind (runtime.c sn_lane_poison_on) — the write-every-byte shape
// the pre-DIFF-6 unconditional memset used to impose. The driver runs both
// and prefixes the poisoned rows with "z.".
//
// Held fixed vs the twins: N (argv[1], default 10,000,000), 16-byte records,
// the LCG constants and draw order (size BEFORE advance), checksum work
// (pointer-int sum), one scratch-pointer store per op inside the alloc phase,
// read pass = one 8-byte load per record (word 0), no payload stores in raw
// phases, single-threaded, same machine. Peak RSS is taken by the driver via
// /usr/bin/time -l (the 256 MB lane is a virtual reservation; only touched
// pages count).

use std.os

fn report(str row, int alloc_ns, int read_ns, int reset_ns, int ops, int ck) {
    print("BENCH row=" + row + " alloc_ns=" + cast(alloc_ns, str)
        + " read_ns=" + cast(read_ns, str)
        + " reset_ns=" + cast(reset_ns, str)
        + " ops=" + cast(ops, str)
        + " checksum=" + cast(ck, str))
}

fn main() {
    int n = 10000000
    list<str> a = args()
    if (a.length() > 1) {
        int v = cast(a[1], int)
        if (v > 0) {
            n = v
        }
    }

    // scratch pointer array (untimed setup; parity with the C/Rust/Go twins)
    ptr scratch = ptr_alloc(8 * n)

    // warmup: N/100 uniform allocs inside one region (icache + branch state;
    // amortized phases still fault their pages inside the timed runs — the
    // twins do the same)
    region {
        int w = 0
        while (w < n / 100) {
            ptr pw = lane_alloc(0, 16)
            w = w + 1
        }
    }

    // ---- timer overhead: 100_000 time_now_ms() call pairs
    int t0 = time_now_ms()
    int kt = 0
    int acct = 0
    while (kt < 100000) {
        acct = acct + time_now_ms()
        kt = kt + 1
    }
    int t1 = time_now_ms()
    report("timer", (t1 - t0) * 1000000 / 100000, 0, 0, 100000, acct)

    // ---- save/restore pair cost on an idle lane (region-construct overhead)
    int t2 = time_now_ms()
    int k2 = 0
    while (k2 < 1000000) {
        ptr wm = lane_save(0)
        lane_restore(0, wm)
        k2 = k2 + 1
    }
    int t3 = time_now_ms()
    report("resetpair", (t3 - t2) * 1000000 / 1000000, 0, 0, 1000000, 0)

    // ---- empty loop tax
    int t4 = time_now_ms()
    int i0 = 0
    int acc0 = 0
    while (i0 < n) {
        acc0 = acc0 + 1
        i0 = i0 + 1
    }
    int t5 = time_now_ms()
    report("emptyloop", (t5 - t4) * 1000000 / n, 0, 0, n, acc0)

    // ---- amort16: one region { } around the loop (region syntax per
    // tests/systems/test_region.sn); alloc + scratch store + read pass all
    // inside the live region.
    int acc1 = 0
    int sum1 = 0
    int used1 = 0
    int ta0 = time_now_ms()
    region {
        ptr p0 = lane_alloc(0, 16)
        acc1 = acc1 + ptr_int(p0)
        ptr_store(scratch, 0, ptr_int(p0))
        int i = 1
        while (i < n) {
            ptr p = lane_alloc(0, 16)
            acc1 = acc1 + ptr_int(p)
            ptr_store(scratch, i * 8, ptr_int(p))
            i = i + 1
        }
        used1 = lane_used(0)
        int j = 0
        while (j < n) {
            ptr q = int_ptr(ptr_load(scratch, j * 8))
            sum1 = sum1 + ptr_load(q, 0)
            j = j + 1
        }
    }
    int ta1 = time_now_ms()
    report("amort16", (ta1 - ta0) * 1000000 / n, 0, 0, n, acc1 + sum1)
    print("lane_used_bytes=" + cast(used1, str))

    // ---- amort16x: explicit lane_save/lane_restore — alloc, read and the
    // wholesale reset timed separately.
    int acc2 = 0
    int sum2 = 0
    int tb0 = time_now_ms()
    ptr wm = lane_save(0)
    ptr q0 = lane_alloc(0, 16)
    acc2 = acc2 + ptr_int(q0)
    ptr_store(scratch, 0, ptr_int(q0))
    int i2 = 1
    while (i2 < n) {
        ptr p = lane_alloc(0, 16)
        acc2 = acc2 + ptr_int(p)
        ptr_store(scratch, i2 * 8, ptr_int(p))
        i2 = i2 + 1
    }
    int tb1 = time_now_ms()
    int j2 = 0
    while (j2 < n) {
        ptr q = int_ptr(ptr_load(scratch, j2 * 8))
        sum2 = sum2 + ptr_load(q, 0)
        j2 = j2 + 1
    }
    int tb2 = time_now_ms()
    lane_restore(0, wm)
    int tb3 = time_now_ms()
    report("amort16x", (tb1 - tb0) * 1000000 / n, (tb2 - tb1) * 1000000 / n, (tb3 - tb2) * 1000000 / n, n, acc2 + sum2)

    // ---- fresh16: region { } per iteration (save/restore inside the loop)
    int acc3 = 0
    int tf0 = time_now_ms()
    int i3 = 0
    while (i3 < n) {
        region {
            ptr p = lane_alloc(0, 16)
            acc3 = acc3 + ptr_int(p)
        }
        i3 = i3 + 1
    }
    int tf1 = time_now_ms()
    report("fresh16", (tf1 - tf0) * 1000000 / n, 0, 0, n, acc3)

    // ---- fresh4k: the same at 4096 B (memset-sensitivity row)
    int acc4 = 0
    int tg0 = time_now_ms()
    int i4 = 0
    while (i4 < n) {
        region {
            ptr p = lane_alloc(0, 4096)
            acc4 = acc4 + ptr_int(p)
        }
        i4 = i4 + 1
    }
    int tg1 = time_now_ms()
    report("fresh4k", (tg1 - tg0) * 1000000 / n, 0, 0, n, acc4)

    // ---- freshlcg: irregular sizes from the fixed LCG (draw BEFORE advance,
    // identical constants in every twin)
    int st = 12345
    int acc5 = 0
    int tl0 = time_now_ms()
    int i5 = 0
    while (i5 < n) {
        int sz = 16 + st % 48
        region {
            ptr p = lane_alloc(0, sz)
            acc5 = acc5 + ptr_int(p)
        }
        st = (st * 1103515245 + 12345) % 2147483648
        i5 = i5 + 1
    }
    int tl1 = time_now_ms()
    report("freshlcg", (tl1 - tl0) * 1000000 / n, 0, 0, n, acc5)
    print("lcg_state_final=" + cast(st, str))

    print("SN_LANE_BENCH_DONE")
}
