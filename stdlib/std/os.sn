fn getenv(str name) -> str? {
    return os_getenv(name)
}

fn exit(int code) {
    os_exit(code)
}

fn args() -> list<str> {
    return os_args()
}

fn exec(str cmd, list<str> args) -> (int, str, error) {
    return os_exec(cmd, args)
}

fn system(str cmd) -> (int, str, error) {
    return os_system(cmd)
}
