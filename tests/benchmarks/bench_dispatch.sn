// Method Dispatch Benchmark
// Measures the performance of 1,000,000 method calls on a blueprint instance.
// Demonstrates devirtualization performance (direct call + LLVM inlining vs indirect vtable dispatch).

blueprint Point {
    int x
    int y

    fn add(int dx, int dy) {
        self.x = self.x + dx
        self.y = self.y + dy
    }

    fn distance_sq() -> int {
        return self.x * self.x + self.y * self.y
    }
}

fn main() {
    print("==================================================")
    print("  SNlang Benchmark: Method Dispatch (1,000,000 calls)")
    print("==================================================")

    new Point pt(x: 0, y: 0)
    int iterations = 1000000

    int start_time = time_now_ms()
    int i = 0
    while (i < iterations) {
        pt.add(1, 2)
        i = i + 1
    }
    int end_time = time_now_ms()
    int elapsed = end_time - start_time
    if (elapsed == 0) {
        elapsed = 1
    }

    print("Iterations: " + cast(iterations, str))
    print("Elapsed time: " + cast(elapsed, str) + " ms")
    int ops_per_sec = (iterations * 1000) / elapsed
    print("Throughput: " + cast(ops_per_sec, str) + " calls/sec")
    print("Verification: x=" + cast(pt.x, str) + ", y=" + cast(pt.y, str))
    print("Verification distance_sq=" + cast(pt.distance_sq(), str))
    print("==================================================")
}
